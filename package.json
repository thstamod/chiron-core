{
  "name": "chiron-core",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source earnings research foundation",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @chiron/api --filter @chiron/web dev",
    "dev:api": "pnpm --filter @chiron/api dev",
    "dev:web": "pnpm --filter @chiron/web dev",
    "dev:worker": "pnpm --filter @chiron/worker dev",
    "worker:health": "pnpm --filter @chiron/worker health",
    "worker:validate-watchlist": "pnpm --filter @chiron/worker validate:watchlist",
    "worker:sync-filings": "pnpm --filter @chiron/worker sync:filings",
    "worker:sync-documents": "pnpm --filter @chiron/worker sync:documents",
    "worker:sync-events": "pnpm --filter @chiron/worker sync:events",
    "worker:sync-prices": "pnpm --filter @chiron/worker sync:prices",
    "worker:extract-document-text": "pnpm --filter @chiron/worker extract:document-text",
    "worker:extract-financial-metrics": "pnpm --filter @chiron/worker extract:financial-metrics",
    "worker:calculate-financial-derived-metrics": "pnpm --filter @chiron/worker calculate:financial-derived-metrics",
    "worker:preview-qualitative": "pnpm --filter @chiron/worker preview:qualitative",
    "worker:extract-qualitative": "pnpm --filter @chiron/worker extract:qualitative",
    "worker:review-qualitative": "pnpm --filter @chiron/worker review:qualitative",
    "worker:preview-historical-reconstruction-plan": "pnpm --filter @chiron/worker preview:historical-reconstruction-plan",
    "worker:create-historical-reconstruction-plan": "pnpm --filter @chiron/worker create:historical-reconstruction-plan",
    "worker:preview-historical-qualitative": "pnpm --filter @chiron/worker preview:historical-qualitative",
    "worker:extract-historical-qualitative": "pnpm --filter @chiron/worker extract:historical-qualitative",
    "worker:preview-historical-prediction": "pnpm --filter @chiron/worker preview:historical-prediction",
    "worker:create-historical-prediction": "pnpm --filter @chiron/worker create:historical-prediction",
    "worker:preview-historical-evaluation": "pnpm --filter @chiron/worker preview:historical-evaluation",
    "worker:preview-historical-price-backfill": "pnpm --filter @chiron/worker preview:historical-price-backfill",
    "worker:backfill-historical-prices": "pnpm --filter @chiron/worker backfill:historical-prices",
    "worker:preview-prediction": "pnpm --filter @chiron/worker preview:prediction",
    "worker:create-prediction": "pnpm --filter @chiron/worker create:prediction",
    "worker:preview-evaluation": "pnpm --filter @chiron/worker preview:evaluation",
    "worker:create-evaluation": "pnpm --filter @chiron/worker create:evaluation",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "check": "pnpm typecheck && pnpm build"
  },
  "engines": {
    "node": ">=22"
  }
}
