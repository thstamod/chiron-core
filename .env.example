# Server-only Supabase values. Never prefix the secret key with VITE_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Public SEC access needs an identifying application name and contact email.
SEC_USER_AGENT="Chiron Research your-email@example.com"
